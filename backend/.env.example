# Voxora Voice settings. setup.bat copies this file to ".env" for you.
# Lines that start with # are comments. Save the file, then restart run.bat for changes to apply.

# --- First sign-in (used ONLY the first time the app starts, to create the Super Admin) ---
ADMIN_EMAIL=admin@voxora.local
ADMIN_PASSWORD=ChangeMe@123

# --- Demo data: three demo companies with sample calls so the dashboards are not empty ---
# Set to false when you want a clean database (delete backend/data/voxora.db first).
SEED_DEMO=true

# --- Security ---
# Leave SECRET_KEY empty: a random key is created once and saved in backend/data/.secret_key
# SECRET_KEY=

# --- AI providers. The defaults cost nothing and need no key. ---
# LLM_PROVIDER: mock (built-in, free, offline) or gemini (Google AI Studio free tier)
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Model names change over time. If Gemini says "model not found", copy a current free model name from Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# STT (speech to text) and TTS (text to speech): browser (free, uses Chrome or Edge) or sarvam
STT_PROVIDER=browser
TTS_PROVIDER=browser
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# --- Limits that keep a small laptop happy ---
MAX_LIVE_SESSIONS=5
IDLE_TIMEOUT_SEC=120
TOKEN_HOURS=12
